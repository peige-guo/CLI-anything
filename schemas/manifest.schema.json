{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLI Anything Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description", "effect", "inputSchema", "verification", "bindings"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$", "maxLength": 100 },
          "description": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["read", "write", "destructive"] },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 30000 },
          "verification": {
            "type": "array", "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "pointer", "contains"],
                  "properties": { "type": { "const": "result-contains" }, "pointer": { "type": "string", "pattern": "^(|/.*)$" }, "contains": { "type": "string", "minLength": 1 } }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "pointer", "equals"],
                  "properties": { "type": { "const": "result" }, "pointer": { "type": "string", "pattern": "^(|/.*)$" }, "equals": {} }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "path"],
                  "properties": { "type": { "const": "file-exists" }, "path": { "type": "string", "minLength": 1 }, "nonEmpty": { "type": "boolean" } }
                }
              ]
            }
          },
          "bindings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "adapter", "config"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "priority": { "type": "integer", "default": 0 },
                "config": { "type": "object" }
              }
            }
          },
          "provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["backend", "source"],
            "properties": { "backend": { "type": "string" }, "source": { "type": "string" }, "notes": { "type": "string" } }
          }
        }
      }
    }
  }
}
